---
import Icon from "@/components/Icon.astro";
import { site, serviceCategories, socialLinks } from "@/data/site";

const year = new Date().getFullYear();

const footerTreatments = serviceCategories.map((cat) => ({
  label: cat.label,
  href: "/#services",
}));
const footerExplore = [
  { label: "Home", href: "/" },
  { label: "About Us", href: "/#about" },
  { label: "Results", href: "/#results" },
  { label: "Reviews", href: "/#reviews" },
  { label: "Blog", href: "/#blog" },
  { label: "FAQ", href: "/#faq" },
  { label: "Book Appointment", href: "/appointment" },
];

// Shared type styles so every column heading and link reads the same and the
// palette (champagne headings, gold-on-hover links) lives in one place.
const headingCls = "text-xs font-semibold uppercase tracking-[0.22em] text-gold-champagne";
const linkCls = "text-ivory/70 transition-colors hover:text-gold-rich";
---

<!-- The Appointment section above is sage; the footer drops to a deeper olive
     gradient so the two read as distinct bands, joined by a gold seam. Soft
     blush and gold blooms echo the clinic's pink-and-gold lighting. -->
<footer
  class="relative isolate overflow-hidden bg-gradient-to-b from-olive to-[#3a4034] text-ivory/75"
>
  <div class="h-1 w-full bg-gold-grad" aria-hidden="true"></div>

  <!-- palette blooms -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-32 top-10 h-80 w-80 rounded-full bg-rose/10 blur-3xl"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-12 -right-24 h-72 w-72 rounded-full bg-gold/15 blur-3xl"
  >
  </div>

  <div class="container-wide relative py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10" data-stagger="120">
      <!-- Brand + big logo + socials -->
      <div class="reveal lg:col-span-4">
        <a href="/" class="inline-flex" aria-label={`${site.name} home`}>
          <img
            src="/images/auresca-logo.svg"
            alt={`${site.name} — ${site.tagline}`}
            width="1254"
            height="1254"
            loading="lazy"
            class="h-52 w-auto brightness-0 invert sm:h-64"
          />
        </a>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-ivory/65">
          {site.shortPitch}
        </p>
        <div class="mt-7 flex items-center gap-3">
          {
            socialLinks.map((s) => (
              <a
                href={s.href}
                aria-label={`${site.name} on ${s.label}`}
                target="_blank"
                rel="noopener noreferrer"
                class="grid h-10 w-10 place-items-center rounded-full border border-white/20 text-ivory/80 transition hover:border-gold hover:bg-gold/10 hover:text-gold-champagne"
              >
                <Icon name={s.name} cls="w-5 h-5" />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Treatments -->
      <div class="reveal lg:col-span-3">
        <h3 class={headingCls}>Treatments</h3>
        <ul class="mt-5 space-y-3 text-sm">
          {
            footerTreatments.map((item) => (
              <li>
                <a href={item.href} class={linkCls}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Explore -->
      <div class="reveal lg:col-span-2">
        <h3 class={headingCls}>Explore</h3>
        <ul class="mt-5 space-y-3 text-sm">
          {
            footerExplore.map((item) => (
              <li>
                <a href={item.href} class={linkCls}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div class="reveal lg:col-span-3">
        <h3 class={headingCls}>Get in Touch</h3>
        <ul class="mt-5 space-y-4 text-sm">
          <li class="flex items-start gap-3 text-ivory/70">
            <Icon name="location" cls="w-5 h-5 shrink-0 text-gold/80" />
            <span>{site.address}</span>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="phone" cls="w-5 h-5 shrink-0 text-gold/80" />
            <a href={site.phoneHref} class={linkCls}>{site.phone}</a>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="mail" cls="w-5 h-5 shrink-0 text-gold/80" />
            <a href={`mailto:${site.email}`} class={linkCls}>{site.email}</a>
          </li>
          <li class="flex items-center gap-3 text-ivory/70">
            <Icon name="clock" cls="w-5 h-5 shrink-0 text-gold/80" />
            <span>{site.hours}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-14 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-xs text-ivory/55 sm:flex-row"
    >
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="font-display text-sm italic tracking-wide text-gold-champagne">
        {site.tagline}
      </p>
    </div>
  </div>
</footer>
