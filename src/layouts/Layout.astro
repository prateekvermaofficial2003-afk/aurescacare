---
import { Font } from "astro:assets";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AppointmentModal from "@/components/AppointmentModal.astro";
import { site } from "@/data/site";
import { clinicSchema, websiteSchema, DEFAULT_OG_IMAGE } from "@/lib/seo";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  /** Absolute or root-relative social share image; falls back to the brand OG. */
  image?: string;
  /** Keep a page (e.g. the booking thank-you) out of the index. */
  noindex?: boolean;
}

const {
  title = `${site.name} — Reveal · Restore · Radiate`,
  description = site.shortPitch,
  bodyClass = "",
  image,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Social image: a page's own hero when given, else the branded default. Both
// are resolved to absolute URLs — crawlers reject relative og:image paths.
const ogImage = image
  ? new URL(image, Astro.site).href
  : DEFAULT_OG_IMAGE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      The page background lives on `body`, which is styled by the external
      stylesheet — so until that parses the browser paints its own white
      canvas and the load flashes. Setting it on `html` inline puts the colour
      in place on the very first paint. `color-scheme` stops the same flash
      happening in reverse for anyone browsing with a dark UA default.
    -->
    <style is:inline>
      html {
        background-color: #f9f7f2;
        color-scheme: light;
      }
    </style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F9F7F2" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />
    <!-- Enable JS-only entrance animations early to avoid a flash -->
    <script is:inline>
      document.documentElement.classList.add("js");
      /*
       * A refresh should start at the top. Two separate things drag it
       * elsewhere, and both land near the bottom of the page:
       *
       *  1. The browser restores the scroll offset it saved against the fully
       *     grown document. At first paint the page is shorter — the reviews
       *     widget renders empty until its third-party script fills it in — so
       *     that offset is clamped to whatever the height is right then.
       *  2. The URL may still carry a fragment from an earlier "Book
       *     Appointment" click. `#appointment` is the last band before the
       *     footer, so the browser jumps straight to it.
       *
       * Both are only corrected when the navigation is a reload. Arriving at a
       * deep link from somewhere else still scrolls to the section, and normal
       * back/forward navigation keeps its restored position.
       */
      var navEntry =
        performance.getEntriesByType &&
        performance.getEntriesByType("navigation")[0];

      if (navEntry && navEntry.type === "reload") {
        if ("scrollRestoration" in history) {
          history.scrollRestoration = "manual";
        }
        if (location.hash) {
          history.replaceState(null, "", location.pathname + location.search);
        }
      }
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon (inline lotus mark — no extra request) -->
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%234E5645'/%3E%3Ctext x='16' y='23' font-family='Georgia,serif' font-size='20' fill='%23E8D2A3' text-anchor='middle'%3EA%3C/text%3E%3C/svg%3E"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Structured data: the clinic (LocalBusiness) + the site, on every page -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(clinicSchema)}
      is:inline
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
      is:inline
    />

    <!-- Self-hosted fonts (see `fonts` in astro.config.mjs) -->
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-ui" preload />
  </head>
  <body class={`${bodyClass} bg-ivory text-charcoal`}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-olive focus:px-5 focus:py-2 focus:text-white"
      >Skip to content</a
    >

    <Header />

    <main id="main"><slot /></main>

    <Footer />

    <AppointmentModal />

    <script>
      // Every interactive feature is a small, self-contained module that runs
      // on import and no-ops when its markup is not on the page.
      import "../scripts/nav.js";
      import "../scripts/hero.js";
      import "../scripts/services.js";
      import "../scripts/before-after.js";
      import "../scripts/results.js";
      import "../scripts/faq.js";
      import "../scripts/appointment.js";
      import "../scripts/appointment-modal.js";
      import "../scripts/reveal.js";
      import "../scripts/counters.js";
    </script>
  </body>
</html>
